{
  "name": "dsh-jmcomic-tools",
  "version": "0.1.0",
  "description": "DeepSeek Harness 用的漫画工具：按编号下一本、原图打成一个 zip（自检后删源目录）、只查标题和作者。",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dsh-jmcomic-fetch": "fetch.mjs",
    "dsh-jmcomic-title": "title.mjs"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "fetch.mjs",
    "title.mjs",
    "packzip.py",
    "pack7z.py",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "jmcomic",
    "comic",
    "downloader",
    "zip"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": "0.2.1-rc.3"
    }
  }
}
